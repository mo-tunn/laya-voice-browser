{
  "name": "laya-voice-browser",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Control a real browser by voice. Deterministic routing plus local laya-browser page decisions; Playwright executes.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "setup:laya": "powershell -ExecutionPolicy Bypass -File scripts/setup-laya.ps1",
    "start": "node src/start.js",
    "demo": "node scripts/demo.js",
    "demo:ci": "node scripts/demo.js --headless",
    "test": "node --test test/unit/*.test.js",
    "test:integration": "node --test test/integration/*.test.js",
    "test:all": "node --test test/unit/*.test.js test/integration/*.test.js"
  },
  "dependencies": {
    "express": "^4.19.2",
    "playwright": "^1.47.0",
    "ws": "^8.18.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mo-tunn/laya-voice-browser.git"
  }
}
