# Local Laya inference. No hosted API key is required.
# LAYA_URL=http://127.0.0.1:8001
# LAYA_MODEL=cklxx/laya-browser
# LAYA_DEVICE=cuda  # optional; omit for Laya auto-detection
# LAYA_AUTO_START=1
# LAYA_WARMUP=1
# LAYA_START_TIMEOUT_MS=300000
# LAYA_TIMEOUT_MS=30000

# Browser control server
# PORT=8787
